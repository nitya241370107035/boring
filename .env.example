# SentinelLog Environment Configuration

# Server & Ingestion API
API_HOST=127.0.0.1
API_PORT=8000
SENTINEL_API_KEYS=sentinel-secret-key-1,sentinel-secret-key-agent,sentinel-secret-key-dash

# Database Configuration (PostgreSQL for Docker, SQLite fallback for local dev)
DATABASE_URL=sqlite:///./sentinellog.db
# DATABASE_URL=postgresql://sentinel:securepassword@localhost:5432/sentinellog

# Dashboard Settings
DASHBOARD_API_URL=http://127.0.0.1:8000
DASHBOARD_API_KEY=sentinel-secret-key-dash

# Agent Settings
AGENT_API_URL=http://127.0.0.1:8000/ingest/agent
AGENT_API_KEY=sentinel-secret-key-agent
AGENT_BUFFER_DB=agent_buffer.db

# Alerting Integrations (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Paths
WEB_RULES_PATH=rules/web_rules.yaml
ENDPOINT_RULES_PATH=rules/endpoint_rules.yaml
ALLOWLIST_PATH=rules/allowlist.yaml
GEOIP_DB_PATH=data/external/GeoLite2-City.mmdb
